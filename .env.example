# ==============================================================================
# ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and insert your real Gemini API key.
# This template is safe to commit to GitHub because it contains no real secrets.
# ==============================================================================

# Google Gemini API Key (Get your personal key at https://aistudio.google.com/)
GEMINI_API_KEY=your_key_here

# Gemini Model strictly configured to Gemini 3.8 Flash
GEMINI_MODEL=gemini-3.8-flash

# Local Server Port
PORT=3000
